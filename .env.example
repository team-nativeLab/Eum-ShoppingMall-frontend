# 목 API(mock)와 실제 API(real) 전환. real은 아직 스텁입니다.
# 공개 환경변수(NEXT_PUBLIC_*, VITE_*)는 브라우저 번들에 포함되므로 비밀값을 넣지 않습니다.
#
# 빌드 규칙(next.config.ts / vite.config.ts가 빌드 시점에 검사)
# - 운영 빌드는 *_API_MODE를 반드시 명시합니다. 비우면 빌드가 실패합니다. 배포는 real + API_BASE_URL.
# - mock으로 운영 빌드하려면 ALLOW_MOCK_IN_PRODUCTION=true를 함께 지정해야 합니다(검증·시연용).
# - admin은 --mode staging 등 어떤 Vite 모드로 빌드해도 같은 검사를 합니다.
# - apps/web/.env.production(커밋됨)에 목 데모 값(mock + ALLOW_MOCK_IN_PRODUCTION=true)이 있어
#   환경변수 없이 `npm run build:web`/Vercel 빌드가 목 데모로 진행됩니다.
#   real 전환은 배포 환경변수(Vercel)에 NEXT_PUBLIC_API_MODE=real과 NEXT_PUBLIC_API_BASE_URL을 설정합니다(실제 env가 우선).
# - 루트 `npm run build`는 로컬에서 모드가 없으면 목 모드 검증 빌드로 진행합니다(scripts/build-all.mjs, 배포용 아님).
#   CI(CI=true)에서는 기본값 없이 실패하므로 워크플로 env에 모드를 명시합니다.

# apps/web (Next.js) — apps/web/.env.local 에 복사해서 사용합니다
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# 목 응답 시나리오: normal | empty | error (로딩·빈·에러 화면 확인용)
NEXT_PUBLIC_MOCK_SCENARIO=normal
# NEXT_PUBLIC_ALLOW_MOCK_IN_PRODUCTION=true

# apps/admin (Vite) — apps/admin/.env.local 에 복사해서 사용합니다
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8080/api
VITE_MOCK_SCENARIO=normal
# VITE_ALLOW_MOCK_IN_PRODUCTION=true
# TopBar "쇼핑몰 보기" 링크 주소(비우면 링크를 숨깁니다)
VITE_WEB_BASE_URL=http://localhost:3000
